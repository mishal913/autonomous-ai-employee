# Autonomous AI Employee - local application environment
# Copy to .env and replace all CHANGE_ME values.
# Never commit the populated .env file.

# LLM
XKIRO_API_KEY=CHANGE_ME
XKIRO_BASE_URL=https://api.xkiro.com/v1
XKIRO_MODEL=mistralai/mistral-large-2512

# Web research
TAVILY_API_KEY=CHANGE_ME

# Application authentication
APP_JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
AUTH_TOKEN_HOURS=8
AUTH_COOKIE_SECURE=false

# Optional Hugging Face token
# HF_TOKEN=CHANGE_ME
