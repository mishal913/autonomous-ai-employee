# ============================================================
# AUTONOMOUS AI EMPLOYEE — PRODUCTION ENVIRONMENT TEMPLATE
# ============================================================
#
# Copy this file to:
#
#   .env.production
#
# NEVER commit .env.production.
# Replace every CHANGE_ME value before deployment.


# -------------------------
# Container images
# -------------------------

GHCR_OWNER=CHANGE_ME_GITHUB_USERNAME
IMAGE_TAG=latest


# -------------------------
# Public hostname
# -------------------------
#
# Example:
# ai.yourdomain.com
#
# DNS A record must point to the VPS public IPv4 address.

APP_DOMAIN=CHANGE_ME_DOMAIN


# -------------------------
# PostgreSQL
# -------------------------

DOCKER_POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD


# -------------------------
# LLM / Web research
# -------------------------

XKIRO_API_KEY=CHANGE_ME
XKIRO_BASE_URL=https://api.xkiro.com/v1
XKIRO_MODEL=mistralai/mistral-large-2512

TAVILY_API_KEY=CHANGE_ME


# -------------------------
# Application authentication
# -------------------------

APP_JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
APP_ADMIN_EMAIL=CHANGE_ME_ADMIN_EMAIL
APP_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

AUTH_TOKEN_HOURS=8
AUTH_COOKIE_SECURE=true


# -------------------------
# Optional Hugging Face token
# -------------------------
#
# The embedding model can often download without this,
# but authenticated downloads have better rate limits.

# HF_TOKEN=CHANGE_ME
